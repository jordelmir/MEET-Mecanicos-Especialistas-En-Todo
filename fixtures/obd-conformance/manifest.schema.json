{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meet-elysium.invalid/schemas/obd-conformance-manifest-v1.json",
  "title": "MEET OBD Conformance Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "capturedAt", "fixtureType", "adapter", "transport", "ecuEndpoints", "software", "files", "review"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 16},
    "capturedAt": {"type": "string", "format": "date-time"},
    "fixtureType": {"enum": ["REAL_VEHICLE", "APPROVED_ECU_BENCH", "REPLAY_ONLY"]},
    "vehicleBindingHash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "adapter": {"type": "object", "required": ["manufacturer", "model", "firmware"], "properties": {"manufacturer":{"type":"string"},"model":{"type":"string"},"firmware":{"type":"string"}}, "additionalProperties": false},
    "transport": {"enum": ["BLUETOOTH_CLASSIC", "BLE", "WIFI_TCP", "DOIP"]},
    "ecuEndpoints": {"type":"array", "minItems":1, "items":{"type":"string","minLength":1}},
    "software": {"type":"object", "required":["appCommit","parserVersion"], "properties":{"appCommit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"parserVersion":{"type":"string","minLength":1}}, "additionalProperties": false},
    "files": {"type":"array", "minItems":1, "items":{"type":"object","required":["path","sha256","mediaType"],"properties":{"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"mediaType":{"type":"string"}},"additionalProperties":false}},
    "review": {"type":"object", "required":["state"], "properties":{"state":{"enum":["CAPTURED","REVIEWED","REJECTED"]},"reviewer":{"type":["string","null"]},"signature":{"type":["string","null"]}}, "additionalProperties":false}
  }
}
