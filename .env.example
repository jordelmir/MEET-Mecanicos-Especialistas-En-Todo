# MEET — Environment Variables Template
# Copy this file to .env or .env.local and fill in credentials locally.
# NEVER commit real .env, .env.local, service-role keys, database passwords,
# Android signing keys, or Supabase CLI temp files to version control.

VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Android build config reads these from android/local.properties.
# Keep them here only as a reference for local environment tooling.
ELYSIUM_SUPABASE_URL=your-supabase-url
ELYSIUM_SUPABASE_KEY=your-supabase-anon-or-publishable-key
RIDE_MAP_STYLE_URL=https://your-map-style-provider.example/style.json
RIDE_GEOCODER_URL=https://your-photon-provider.example/api/
RIDE_ROUTER_URL=https://your-osrm-provider.example

# Supabase CLI / backend operations only.
# Do NOT ship these in the Android APK or frontend bundle.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=your-supabase-url
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_ANON_KEY=your-supabase-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=your-sb-secret-key
SUPABASE_DB_PASSWORD=your-database-password

# Android release signing; keep real values in android/local.properties
# or another ignored local-only secret file.
KEYSTORE_PATH=your-release-keystore-path
KEYSTORE_PASSWORD=your-keystore-password
KEY_ALIAS=your-key-alias
KEY_PASSWORD=your-key-password

# Optional AI provider settings for local reference.
# Android users can also configure these inside the APK under Ajustes > Motor IA.
# Never commit real user API keys.
AI_PROVIDER=gemini
AI_API_KEY=your-user-supplied-ai-key
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL_NAME=gpt-4o-mini
