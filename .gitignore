# ═══════════════════════════════════════════════════
#  MEET — Master .gitignore
# ═══════════════════════════════════════════════════

# --- Environment & Secrets ---
.env
.env.local
.env.development
.env.production
.env.test
.env.*.local
*.env
*.env.*
!.env.example
.env.keys
.env.vault
.envrc
CREDENTIALS*
credentials*
*.credentials
*.secret
*.secrets
secrets.*
service-role*
service_role*
anon-key*
publishable-key*
*.pem
*.key
*.p12
*.mobileprovision

# --- Node.js ---
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# --- Editor & IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# --- Vercel ---
.vercel/

# --- Android Build Outputs ---
android/app/build/
android/.gradle/
android/build/
artifacts/physical-device/
android/local.properties
android/**/local.properties
android/gradle-8.5/
android/gradle-8.5-bin.zip
temp_gradle/
server/.gradle/
server/build/
*.hprof

# --- Android Signing ---
*.jks
*.keystore
android/*.jks
android/*.keystore
android/app/*.jks
android/app/*.keystore
keystore.properties
signing.properties

# --- Supabase Local/Remote Secrets ---
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.*
supabase/functions/.env
supabase/functions/.env.*
supabase/secrets.env
supabase/.secrets
supabase/.secrets.*
supabase/.mcp.json
supabase/.cli-token
**/.supabase-access-token

# --- Additional secret-bearing local configuration ---
*.properties.local
**/secrets.properties
**/credentials.json
**/service-account*.json

# --- Python Temp ---
__pycache__/
*.pyc

# --- Generated Knowledge Ingestion Artifacts ---
build/knowledge/

# --- Isolated Codex Worktrees ---
.worktrees/

# --- APK Releases (track only latest) ---
!releases/*.apk

# --- Temp / Debug Logs ---
*.log
crash_log.txt
full_log.txt
logcat_dump.txt
android/error_log.txt
android/screen.png
*.bak

# --- Reference Images (local only) ---
imagenes_referencia/

# --- OS Generated ---
Thumbs.db
ehthumbs.db
Desktop.ini
.vercel
