{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meet.local/schemas/automotive-knowledge-graph.schema.json",
  "title": "MEET Evidence-Gated Automotive Knowledge Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceCorpusHash",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "overlayId": {
      "$ref": "#/$defs/id"
    },
    "overlayVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "graphId": {
      "$ref": "#/$defs/id"
    },
    "graphVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sourceCorpusHash": {
      "$ref": "#/$defs/sha256"
    },
    "contentSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sourceInputs": {
      "$ref": "#/$defs/sourceInputs"
    },
    "referenceVehicleProfile": {
      "$ref": "#/$defs/vehicleProfile"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vehicleProfile"
      }
    },
    "applicabilityRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/applicabilityRule"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nodeType": {
      "type": "string",
      "enum": [
        "SYSTEM",
        "ASSEMBLY",
        "SECTION",
        "COMPONENT",
        "ALIAS",
        "SYMPTOM",
        "DTC",
        "DIAGNOSTIC_TEST",
        "MEASUREMENT",
        "PROCEDURE",
        "PROCEDURE_STEP",
        "TOOL",
        "SAFETY_WARNING",
        "PART_CANDIDATE",
        "VEHICLE_PROFILE",
        "SOURCE_BLOCK",
        "VISUAL_TARGET"
      ]
    },
    "edgeType": {
      "type": "string",
      "enum": [
        "PART_OF",
        "HAS_ALIAS",
        "MAY_CAUSE",
        "MAY_SET_DTC",
        "AFFECTS",
        "CONFIRMED_BY_TEST",
        "HAS_DIAGNOSTIC_TEST",
        "REQUIRES_TEST_BEFORE_REPLACE",
        "USES_TOOL",
        "HAS_WARNING",
        "HAS_PROCEDURE",
        "HAS_STEP",
        "NEXT_STEP",
        "SUGGESTS_PART_CANDIDATE",
        "APPLIES_TO",
        "EXCLUDED_FROM",
        "SUPPORTED_BY_SOURCE",
        "VISUALIZED_BY"
      ]
    },
    "applicabilityState": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "PROBABLE",
        "CONDITIONAL",
        "GENERIC",
        "NOT_DOCUMENTED",
        "NOT_APPLICABLE",
        "CONFLICTED"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNASSESSED"
      ]
    },
    "reviewState": {
      "type": "string",
      "enum": [
        "REVIEWED",
        "REVIEW_REQUIRED",
        "OBSERVED",
        "CONFLICTED"
      ]
    },
    "sourceBlockId": {
      "type": "string",
      "pattern": "^block_[0-9]{6}_[0-9a-f]{10}$"
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDocumentId",
        "blockId",
        "textHash"
      ],
      "properties": {
        "sourceDocumentId": {
          "type": "string",
          "pattern": "^document_[0-9]+$"
        },
        "blockId": {
          "$ref": "#/$defs/sourceBlockId"
        },
        "textHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpusManifestPath",
        "corpusId",
        "corpusVersion",
        "curatedPacks"
      ],
      "properties": {
        "corpusManifestPath": {
          "type": "string",
          "minLength": 1
        },
        "corpusManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "corpusId": {
          "$ref": "#/$defs/id"
        },
        "corpusVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "entityIndexPath": {
          "type": "string",
          "minLength": 1
        },
        "entityIndexSha256": {
          "$ref": "#/$defs/sha256"
        },
        "curatedOverlayPath": {
          "type": "string",
          "minLength": 1
        },
        "curatedOverlaySha256": {
          "$ref": "#/$defs/sha256"
        },
        "curatedPacks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "packId",
              "packVersion",
              "path"
            ],
            "properties": {
              "packId": {
                "$ref": "#/$defs/id"
              },
              "packVersion": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "contentSha256": {
                "$ref": "#/$defs/sha256"
              },
              "authority": {
                "type": "string",
                "minLength": 1
              },
              "reviewState": {
                "$ref": "#/$defs/reviewState"
              }
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "sourceBlockIds",
        "sourceRefs",
        "curatedSourceIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/nodeType"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "canonicalKey": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sourceRecordRole": {
          "type": "string",
          "enum": [
            "COMPONENT_RECORD",
            "REAL_CASE",
            "SECTION_SHARD",
            "LITERAL_BLOCK"
          ]
        },
        "sourceBlockIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceBlockId"
          },
          "uniqueItems": true
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "uniqueItems": true
        },
        "curatedSourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "type",
        "sourceBlockIds",
        "sourceRefs",
        "curatedSourceIds",
        "observedEvidenceIds",
        "evidenceRequired",
        "reviewState",
        "applicability",
        "confidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/edgeType"
        },
        "sourceBlockIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceBlockId"
          },
          "uniqueItems": true
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "uniqueItems": true
        },
        "curatedSourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "observedEvidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidenceRequired": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "reviewState": {
          "$ref": "#/$defs/reviewState"
        },
        "applicability": {
          "$ref": "#/$defs/applicabilityState"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "requiresVinConfirmation": {
          "type": "boolean"
        },
        "requiresOemConfirmation": {
          "type": "boolean"
        },
        "requiresPhysicalConfirmation": {
          "type": "boolean"
        },
        "sequenceId": {
          "$ref": "#/$defs/id"
        },
        "sequenceOrder": {
          "type": "integer",
          "minimum": 1
        }
      },
      "anyOf": [
        {
          "properties": {
            "sourceBlockIds": {
              "minItems": 1
            }
          },
          "required": [
            "sourceBlockIds"
          ]
        },
        {
          "properties": {
            "evidenceRequired": {
              "minItems": 1
            }
          },
          "required": [
            "evidenceRequired"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "CONFIRMED"
              }
            },
            "required": [
              "applicability"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "curatedSourceIds": {
                    "minItems": 1
                  }
                },
                "required": [
                  "curatedSourceIds"
                ]
              },
              {
                "properties": {
                  "observedEvidenceIds": {
                    "minItems": 1
                  }
                },
                "required": [
                  "observedEvidenceIds"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "sourceBlockIds": {
                "minItems": 1
              }
            },
            "required": [
              "sourceBlockIds"
            ]
          },
          "then": {
            "properties": {
              "sourceRefs": {
                "minItems": 1
              }
            },
            "required": [
              "sourceRefs"
            ]
          }
        }
      ]
    },
    "vehicleProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodeId",
        "make",
        "models",
        "year",
        "engine",
        "transmission",
        "marketState",
        "requiresVinConfirmation",
        "applicability",
        "confidence",
        "reviewState",
        "sourceBlockIds",
        "sourceRefs",
        "curatedSourceIds",
        "evidenceRequired"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "make": {
          "type": "string",
          "minLength": 1
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1886
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "transmission": {
          "type": "string",
          "minLength": 1
        },
        "marketState": {
          "type": "string",
          "enum": [
            "CONFIRMED",
            "UNCONFIRMED",
            "MULTIPLE"
          ]
        },
        "requiresVinConfirmation": {
          "type": "boolean"
        },
        "applicability": {
          "$ref": "#/$defs/applicabilityState"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "reviewState": {
          "$ref": "#/$defs/reviewState"
        },
        "sourceBlockIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceBlockId"
          },
          "uniqueItems": true
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "uniqueItems": true
        },
        "curatedSourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidenceRequired": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "applicabilityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profileId",
        "canonicalKey",
        "state",
        "confidence",
        "reviewState",
        "reason",
        "sourceBlockIds",
        "sourceRefs",
        "curatedSourceIds",
        "evidenceRequired"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "profileId": {
          "$ref": "#/$defs/id"
        },
        "canonicalKey": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "$ref": "#/$defs/applicabilityState"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "reviewState": {
          "$ref": "#/$defs/reviewState"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sourceBlockIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceBlockId"
          },
          "uniqueItems": true
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "uniqueItems": true
        },
        "curatedSourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidenceRequired": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "anyOf": [
        {
          "properties": {
            "sourceBlockIds": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "evidenceRequired": {
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
