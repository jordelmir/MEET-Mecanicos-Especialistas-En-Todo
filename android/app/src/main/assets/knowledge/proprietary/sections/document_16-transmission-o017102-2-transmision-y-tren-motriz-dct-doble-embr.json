ecordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"","text":"2. Leer códigos TCM.","textHash":"d1022bd7aaa79c34e2f34e1b96e00978ca3e4b5f49100936d9a1cd7f735c5c7f"},{"blockId":"block_017112_b2b566a8b5","entityId":null,"kind":"paragraph","order":17112,"parentEntityId":"document_16-o017104-debes-confirmar-el-codigo-de-transmision-y-d","recordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"","text":"3. Revisar K2 target vs actual.","textHash":"b2b566a8b51b372a09626dd979c047b40de2e0efcc5ca6aa8600e384e9b58050"},{"blockId":"block_017113_7e97a9ac4a","entityId":null,"kind":"paragraph","order":17113,"parentEntityId":"document_16-o017104-debes-confirmar-el-codigo-de-transmision-y-d","recordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"","text":"4. Revisar slip K2.","textHash":"7e97a9ac4a6a74e141419190b68c41a32ba17878e794710289ffce95977cbb5e"},{"blockId":"block_017114_6052ac3065","entityId":null,"kind":"paragraph","order":17114,"parentEntityId":"document_16-o017104-debes-confirmar-el-codigo-de-transmision-y-d","recordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"","text":"5. Revisar velocidad del input shaft correspondiente.","textHash":"6052ac3065507e8641614222df872908aceacf49333fdf0383d27efbd70395c1"},{"blockId":"block_017115_a55d868759","entityId":null,"kind":"paragraph","order":17115,"parentEntityId":"document_16-o017104-debes-confirmar-el-codigo-de-transmision-y-d","recordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"","text":"6. Revisar actuador K2.","textHash":"a55d868759ddafb70caac30fec5537554f7237c6477672aee84a5b5af902dd76"},{"blockId":"block_017116_f3666e4f81","entityId":null,"kind":"paragraph","order":17116,"parentEntityId":"document_16-o017104-debes-confirmar-el-codigo-de-transmision-y-d","recordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"","text":"7. Revisar horquilla y sensor del grupo par.","textHash":"f3666e4f8116f4164d6af8336f5c324f487e93509bc976fb8e6f5ab7a8e1428e"},{"blockId":"block_017117_4fa8fc0e1b","entityId":null,"kind":"paragraph","order":17117,"parentEntityId":"document_16-o017104-debes-confirmar-el-codigo-de-transmision-y-d","recordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"","text":"8. Revisar presión/mecatrónica.","textHash":"4fa8fc0e1b5694b247170fcbc997325430df9370c1bf8a32de5331bd78936dbd"},{"blockId":"block_017118_706b80fa8c","entityId":null,"kind":"paragraph","order":17118,"parentEntityId":"document_16-o017104-debes-confirmar-el-codigo-de-transmision-y-d","recordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"","text":"9. Solo después condenar K2 o daño interno.","textHash":"706b80fa8cd047f90be2099aace68779a17faefaadbee2656eb79012472758a0"},{"blockId":"block_017119_fa8862e5d1","entityId":"document_16-o017119-caso-3-bomba-mecatronica-frecuente","kind":"paragraph","order":17119,"parentEntityId":null,"recordRole":"COMPONENT","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"","text":"Caso 3: bomba mecatrónica frecuente","textHash":"fa8862e5d1921dad0a92634ab5c8a7ea79136112c2261871ead660bc49d1e297"},{"blockId":"block_017120_e401df3494","entityId":null,"kind":"paragraph","order":17120,"parentEntityId":"document_16-o017119-caso-3-bomba-mecatronica-frecuente","recordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"","text":"Entrada:","textHash":"e401df34940d77269744c377bf21e5c7617c21a324705858e673d2b6def1e1b8"},{"blockId":"block_017121_536a8520f9","entityId":null,"kind":"paragraph","order":17121,"parentEntityId":"document_16-o017119-caso-3-bomba-mecatronica-frecuente","recordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"ListParagraph","text":"La bomba de la DCT enciende cada pocos segundos.","textHash":"536a8520f97924576724dc83e636fb1aff47dac97818fe9e230ee81e669a6c46"},{"blockId":"block_017122_3d11968067","entityId":null,"kind":"paragraph","order":17122,"parentEntityId":"document_16-o017119-caso-3-bomba-mecatronica-frecuente","recordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"","text":"Respuesta esperada:","textHash":"3d11968067cf434a07aa60101fa7139e49a6535d208624a5e77317c74c05a00f"},{"blockId":"block_017123_b493cb891b","entityId":null,"kind":"paragraph","order":17123,"parentEntityId":"document_16-o017119-caso-3-bomba-mecatronica-frecuente","recordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"","text":"La IA debe pedir presión objetivo/real, tiempo de carga, caída de presión, estado del acumulador, fugas internas, corriente de bomba y filtro. No debe recomendar directamente una bomba nueva.","textHash":"b493cb891b9e7d5a44763839adfbf9ce0b26f3ad679dd27e35cb91e90fff0cf3"},{"blockId":"block_017124_12f39b0a0d","entityId":null,"kind":"paragraph","order":17124,"parentEntityId":"document_16-o017119-caso-3-bomba-mecatronica-frecuente","recordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"","text":"Caso 4: vibración en tráfico lento","textHash":"12f39b0a0db9815881232f01c956c14351114739ac4ab30df1b3e9dd67c35cbd"},{"blockId":"block_017125_e401df3494","entityId":null,"kind":"paragraph","order":17125,"parentEntityId":"document_16-o017119-caso-3-bomba-mecatronica-frecuente","recordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"","text":"Entrada:","textHash":"e401df34940d77269744c377bf21e5c7617c21a324705858e673d2b6def1e1b8"},{"blockId":"block_017126_a852de7518","entityId":null,"kind":"paragraph","order":17126,"parentEntityId":"document_16-o017119-caso-3-bomba-mecatronica-frecuente","recordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"ListParagraph","text":"Hyundai/Kia con DCT seca vibra en presas y huele a clutch.","textHash":"a852de7518f2ae29666ef720029da6129157ec8a57156ce5570ca20a292d8b0d"},{"blockId":"block_017127_3d11968067","entityId":null,"kind":"paragraph","order":17127,"parentEntityId":"document_16-o017119-caso-3-bomba-mecatronica-frecuente","recordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"","text":"Respuesta esperada:","textHash":"3d11968067cf434a07aa60101fa7139e49a6535d208624a5e77317c74c05a00f"},{"blockId":"block_017128_7f7623707f","entityId":null,"kind":"paragraph","order":17128,"parentEntityId":"document_16-o017119-caso-3-bomba-mecatronica-frecuente","recordRole":"SOURCE_DETAIL","sectionPath":["2. Transmisión y tren motriz","DCT / doble embrague"],"styleId":"","text":"Debe advertir sobre sobrecalentamiento por deslizamiento, revisar temperatura de clutch, adaptaciones K1/K2, punto de contacto, desgaste, soportes y estilo de conducción. No debe recomendar simplemente un cambio de aceite, porque los discos secos no se reparan cambiando el lubricante de engranajes.","textHash":"7f7623707f19db3023d17ed93fd8a40f22d433723364f2b8de908e0cbc02ff9b"}],"contentSha256":"9341e3cd345ee50a5d49402b2a3f86b28fb70e1a1b80c3224488c63fbe591e06","corpusId":"meet_owner_proprietary_parts_corpus","schemaVersion":1,"sectionId":"document_16-transmission-o017102-2-transmision-y-tren-motriz-dct-doble-embr","sourceDocumentId":"document_16","sourceDocumentSha256":"09f2926a22542a4e7be24e50f2a4f4c42674f32958e8e541683fbb0cf76352d7","sourceFileName":"Document (16).docx","systemId":"transmission","titleOriginal":"2. Transmisión y tren motriz · DCT / doble embrague","vehicleLabel":"Hyundai Accent/Verna 2005 · caja automática · motor 1600 cc"}
