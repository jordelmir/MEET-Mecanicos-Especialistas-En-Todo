tyleId":"","text":"3. Medir batería durante el arranque.","textHash":"2c7aa0f4d581ea5f77ddb9362b3ddcb45aa6df800e3e1a3061f9116de0c3c8a1"},{"blockId":"block_041545_8bb2dc9c06","entityId":null,"kind":"paragraph","order":41545,"parentEntityId":"document_16-o041540-y-el-modulo-carplay-original","recordRole":"SOURCE_DETAIL","sectionPath":["8. ECUs, módulos y controladores","Infotainment"],"styleId":"","text":"4. Revisar alternador y ripple.","textHash":"8bb2dc9c065bc9d4c50c981e74508d0275ed949518becd38034f91fbad0cd7fa"},{"blockId":"block_041546_e8a96147fb","entityId":null,"kind":"paragraph","order":41546,"parentEntityId":"document_16-o041540-y-el-modulo-carplay-original","recordRole":"SOURCE_DETAIL","sectionPath":["8. ECUs, módulos y controladores","Infotainment"],"styleId":"","text":"5. Identificar B+ permanente y ACC.","textHash":"e8a96147fb5521dd06787788b1c0b916f5660746d49181a340e7cde545ec4c97"},{"blockId":"block_041547_800bfc2d5f","entityId":null,"kind":"paragraph","order":41547,"parentEntityId":"document_16-o041540-y-el-modulo-carplay-original","recordRole":"SOURCE_DETAIL","sectionPath":["8. ECUs, módulos y controladores","Infotainment"],"styleId":"","text":"6. Verificar que no estén invertidos.","textHash":"800bfc2d5fb8560b96d24e84022d64da721b4d0a40ab9258177dd056942e6dff"},{"blockId":"block_041548_eb4b1de143","entityId":null,"kind":"paragraph","order":41548,"parentEntityId":"document_16-o041540-y-el-modulo-carplay-original","recordRole":"SOURCE_DETAIL","sectionPath":["8. ECUs, módulos y controladores","Infotainment"],"styleId":"","text":"7. Medir consumo parasitario de la radio.","textHash":"eb4b1de1436afac280a9d74f8019d9839d893802a0a167c4e7aac1974fcefcca"},{"blockId":"block_041549_c45fff5122","entityId":null,"kind":"paragraph","order":41549,"parentEntityId":"document_16-o041540-y-el-modulo-carplay-original","recordRole":"SOURCE_DETAIL","sectionPath":["8. ECUs, módulos y controladores","Infotainment"],"styleId":"","text":"8. Revisar modo sleep.","textHash":"c45fff51223cbdd5d4f020ad7410d96491fa9530563c205e6a3dd598b88480e3"},{"blockId":"block_041550_df60d29f3e","entityId":null,"kind":"paragraph","order":41550,"parentEntityId":"document_16-o041540-y-el-modulo-carplay-original","recordRole":"SOURCE_DETAIL","sectionPath":["8. ECUs, módulos y controladores","Infotainment"],"styleId":"","text":"9. Revisar micrófono y su compatibilidad.","textHash":"df60d29f3e77c8ebfdf68fdb3b97b4644eaa18e68d75b5a298cc7655c16fcaf2"},{"blockId":"block_041551_fe149438c6","entityId":null,"kind":"paragraph","order":41551,"parentEntityId":"document_16-o041540-y-el-modulo-carplay-original","recordRole":"SOURCE_DETAIL","sectionPath":["8. ECUs, módulos y controladores","Infotainment"],"styleId":"","text":"10. Revisar antena GPS y ubicación.","textHash":"fe149438c67c837bd7ed03592447ced4638114e20786f14095375a4203bd7e8b"},{"blockId":"block_041552_598dda34c0","entityId":null,"kind":"paragraph","order":41552,"parentEntityId":"document_16-o041540-y-el-modulo-carplay-original","recordRole":"SOURCE_DETAIL","sectionPath":["8. ECUs, módulos y controladores","Infotainment"],"styleId":"","text":"11. Confirmar que el USB sea de datos.","textHash":"598dda34c05fc6fa9850d16c2b7c9c1790fac99e58507cb51be0108b62dd83b8"},{"blockId":"block_041553_369695afc4","entityId":null,"kind":"paragraph","order":41553,"parentEntityId":"document_16-o041540-y-el-modulo-carplay-original","recordRole":"SOURCE_DETAIL","sectionPath":["8. ECUs, módulos y controladores","Infotainment"],"styleId":"","text":"12. Verificar firmware y compatibilidad CarPlay.","textHash":"369695afc49309442a6c252e26f27a1da8fb61a6f97b3241faa49afb09c01016"},{"blockId":"block_041554_27106048ee","entityId":null,"kind":"paragraph","order":41554,"parentEntityId":"document_16-o041540-y-el-modulo-carplay-original","recordRole":"SOURCE_DETAIL","sectionPath":["8. ECUs, módulos y controladores","Infotainment"],"styleId":"","text":"13. Revisar tierra y conectores.","textHash":"27106048eee10e334dfb4165d202a5a57e7363339b5fe87b32ad15447d4586da"},{"blockId":"block_041555_38783d3230","entityId":null,"kind":"paragraph","order":41555,"parentEntityId":"document_16-o041540-y-el-modulo-carplay-original","recordRole":"SOURCE_DETAIL","sectionPath":["8. ECUs, módulos y controladores","Infotainment"],"styleId":"","text":"14. No cambiar BCM/ETACS.","textHash":"38783d323038c29f810149197a68bcc2ac4dc558b3c006ca8443849bc3d39ae6"},{"blockId":"block_041556_40bd5e9eec","entityId":null,"kind":"paragraph","order":41556,"parentEntityId":"document_16-o041540-y-el-modulo-carplay-original","recordRole":"SOURCE_DETAIL","sectionPath":["8. ECUs, módulos y controladores","Infotainment"],"styleId":"","text":"Criterio de aprobación: la IA debe reconocer el sistema original de radio AM/FM con casete o CD y antena convencional, separar todos los accesorios aftermarket, y no inventar amplificador externo, Bluetooth, GPS, telemática, eCall, pantalla central, cluster digital, HUD, USB ni CarPlay/Android Auto originales.","textHash":"40bd5e9eec7d811ff5d8de3de5e57a9d9f4b1c9d83ae6c9f8dbce4d33e7dd26c"}],"contentSha256":"d83d548b833665b9c5b70504022224bd44ebd4a0db43077f5380d5fa9d025753","corpusId":"meet_owner_proprietary_parts_corpus","schemaVersion":1,"sectionId":"document_16-control_modules-o041495-8-ecus-modulos-y-controladores-infotainmen","sourceDocumentId":"document_16","sourceDocumentSha256":"09f2926a22542a4e7be24e50f2a4f4c42674f32958e8e541683fbb0cf76352d7","sourceFileName":"Document (16).docx","systemId":"control_modules","titleOriginal":"8. ECUs, módulos y controladores · Infotainment","vehicleLabel":"Hyundai Accent/Verna 2005 · caja automática · motor 1600 cc"}
