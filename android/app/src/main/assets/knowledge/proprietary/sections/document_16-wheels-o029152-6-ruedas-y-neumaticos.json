39ee9eecac49775b5e4f744f927ff3fa087c0054c04575db0514255498e2ff"},{"blockId":"block_029189_58796d8774","entityId":null,"kind":"paragraph","order":29189,"parentEntityId":"document_16-o029186-retirala-y-comprueba-presion-medida-patron-v","recordRole":"SOURCE_DETAIL","sectionPath":["6. Ruedas y neumáticos"],"styleId":"","text":"Caso 8 — Tuercas","textHash":"58796d8774d3bcecaad48aa9757284fa8eeea94b6184f8f3d9306283fe1a17f8"},{"blockId":"block_029190_e401df3494","entityId":null,"kind":"paragraph","order":29190,"parentEntityId":"document_16-o029186-retirala-y-comprueba-presion-medida-patron-v","recordRole":"SOURCE_DETAIL","sectionPath":["6. Ruedas y neumáticos"],"styleId":"","text":"Entrada:","textHash":"e401df34940d77269744c377bf21e5c7617c21a324705858e673d2b6def1e1b8"},{"blockId":"block_029191_f2705125f4","entityId":null,"kind":"paragraph","order":29191,"parentEntityId":"document_16-o029186-retirala-y-comprueba-presion-medida-patron-v","recordRole":"SOURCE_DETAIL","sectionPath":["6. Ruedas y neumáticos"],"styleId":"ListParagraph","text":"Las apreté con pistola hasta que ya no giraron.","textHash":"f2705125f4b203d3957143dc8e7d36dff0bc9ac94917c0c89e4ba8c4711f7cd6"},{"blockId":"block_029192_3d11968067","entityId":null,"kind":"paragraph","order":29192,"parentEntityId":"document_16-o029186-retirala-y-comprueba-presion-medida-patron-v","recordRole":"SOURCE_DETAIL","sectionPath":["6. Ruedas y neumáticos"],"styleId":"","text":"Respuesta esperada:","textHash":"3d11968067cf434a07aa60101fa7139e49a6535d208624a5e77317c74c05a00f"},{"blockId":"block_029193_d0ec7dd78a","entityId":null,"kind":"paragraph","order":29193,"parentEntityId":"document_16-o029186-retirala-y-comprueba-presion-medida-patron-v","recordRole":"SOURCE_DETAIL","sectionPath":["6. Ruedas y neumáticos"],"styleId":"","text":"El procedimiento es incorrecto. Deben aflojarse y comprobarse","textHash":"d0ec7dd78a6c36c27397b58509cf0ae02ad25fd0a6c6526ddcb896bca05603aa"},{"blockId":"block_029194_8c89476079","entityId":"document_16-