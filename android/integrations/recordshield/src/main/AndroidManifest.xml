<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <activity android:name="com.elysium.vanguard.recordshield.ui.MainActivity"
            android:exported="false" android:theme="@style/Theme.ElysiumOBD" />
        <service android:name="com.elysium.vanguard.recordshield.service.RecordingService"
            android:exported="false" android:stopWithTask="true"
            android:foregroundServiceType="camera|microphone" />
    </application>
</manifest>
